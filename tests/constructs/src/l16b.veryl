module L16c (i: input logic<16>, o: output logic<3>) {
    import $std::lzc_common_pkg::*;
    var ret4       : result::<4>     [4];
    var any_one    : logic       <4>    ;
    var ret_any_one: result::<4>        ;
    always_comb {
        ret4[0]    = lzc4(i[0 step 4]);
        ret4[1]    = lzc4(i[1 step 4]);
        ret4[2]    = lzc4(i[2 step 4]);
        ret4[3]    = lzc4(i[3 step 4]);
        any_one[0] = !ret4[0].all_zero;
        any_one[1] = !ret4[1].all_zero;
        any_one[2] = !ret4[2].all_zero;
        any_one[3] = !ret4[3].all_zero;
        ret_any_one = lzc4(any_one);
        o = {ret_any_one.all_zero, ret_any_one.count};
    }
}
module L16d (i: input logic<16>, o: output logic<2>) {
    import $std::lzc_common_pkg::*;
    var ret4       : result::<4>     [4];
    var any_one    : logic       <4>    ;
    var ret_any_one: result::<4>        ;
    always_comb {
        ret4[0]    = lzc4(i[0 step 4]);
        ret4[1]    = lzc4(i[1 step 4]);
        ret4[2]    = lzc4(i[2 step 4]);
        ret4[3]    = lzc4(i[3 step 4]);
        any_one[0] = !ret4[0].all_zero;
        any_one[1] = !ret4[1].all_zero;
        any_one[2] = !ret4[2].all_zero;
        any_one[3] = !ret4[3].all_zero;
        ret_any_one = lzc4(any_one);
        o = ret4[ret_any_one.count].count;
    }
}
module L16e (i: input logic<16>, k: input logic<2>, z: input logic, o: output logic<5>) {
    import $std::lzc_common_pkg::*;
    var ret4       : result::<4>     [4];
    var ret        : result::<16>       ;
    always_comb {
        ret4[0]    = lzc4(i[0 step 4]);
        ret4[1]    = lzc4(i[1 step 4]);
        ret4[2]    = lzc4(i[2 step 4]);
        ret4[3]    = lzc4(i[3 step 4]);
        ret.all_zero = z;
        ret.count    = {k, ret4[k].count};
        o = {ret.all_zero, ret.count};
    }
}
module L16f (i: input logic<4>, o: output logic<3>) {
    import $std::lzc_common_pkg::*;
    var any_one    : logic       <4>    ;
    var ret_any_one: result::<4>        ;
    always_comb {
        any_one[0] = !i[0];
        any_one[1] = !i[1];
        any_one[2] = !i[2];
        any_one[3] = !i[3];
        ret_any_one = lzc4(any_one);
        o = {ret_any_one.all_zero, ret_any_one.count};
    }
}
